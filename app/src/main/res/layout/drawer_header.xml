<?xml version="1.0" encoding="utf-8"?>
<!-- Top of the navigation drawer: logo, the nurse's first name, staff ID and
     block. Top padding for the status bar is added at runtime by BaseActivity. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@color/brand_primary"
    android:orientation="vertical"
    android:padding="20dp">

    <com.google.android.material.imageview.ShapeableImageView
        android:layout_width="52dp"
        android:layout_height="52dp"
        android:background="@drawable/bg_logo_white_circle"
        android:padding="2dp"
        android:scaleType="centerCrop"
        android:src="@drawable/logo"
        android:contentDescription="@string/app_name"
        app:shapeAppearanceOverlay="@style/CircleImage" />

    <TextView
        android:id="@+id/text_drawer_name"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:text=""
        android:textColor="@color/white"
        android:textSize="19sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/text_drawer_staff"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:text=""
        android:textColor="@color/brand_on_primary_muted"
        android:textSize="13sp" />
</LinearLayout>
